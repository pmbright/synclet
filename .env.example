# Copy to .env and enter your own credentials. Never commit .env or token files.
MAGENTO_BASE_URL=https://www.bbwear.co.uk/onesaas_connect/index/index
MAGENTO_ACCESS_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=synclet_test
DB_USER=synclet_test
DB_PASSWORD=

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_TOKEN_FILE=qbo_tokens.json

# Options used by the older QuickBooks authorization helper.
QBO_REDIRECT_URI=http://localhost:8000/callback
QBO_ENVIRONMENT=production
QBO_COMPANY_ID=

PAGE_SIZE=500
EXPORT_ON_SYNC=true
CSV_EXPORT_DIR=exports
CSV_EXPORT_SIMPLE=true
CSV_EXPORT_COMPLETE_ONLY=false
CSV_EXPORT_TRACK=true
